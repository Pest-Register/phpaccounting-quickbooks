{
    "name": "pest-register/php-accounting-quickbooks",
    "description": "Quickbooks package for PHP Accounting",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Max",
            "email": "max@pestregister.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-simplexml": "*",
        "guzzlehttp/guzzle": "^7.10",
        "quickbooks/v3-php-sdk": "^6.2.2",
        "fakerphp/faker": "^1.9.1",
        "nesbot/carbon": "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "vlucas/phpdotenv": "^5.0"
    },
    "autoload": {
        "psr-4": { "PHPAccounting\\Quickbooks\\" : "src/" }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "docs": "swagger src/"
    },
    "prefer-stable": true
}
